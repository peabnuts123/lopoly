{
  "references": [
    {
      "path": "../../tsconfig.build.json",
    },
  ],
  "compilerOptions": {
    "module": "esnext",
    "target": "esnext",
    "moduleResolution": "bundler",
    "types": ["vite/client"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],

    "rootDir": ".",
    "noEmit": true,

    "allowJs": true,
    "useDefineForClassFields": true,

    "paths": {
      "@game/*": ["./src/*"],
      // @NOTE These are only needed because the source is in the same repo.
      "@lopoly/engine": ["../../src"],
      "@lopoly/engine/*": ["../../src/*"],
    },

    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
  },
  "include": [
    "src",
    "vite.config.ts",
    "tailwind.config.js",
    "postcss.config.js",
  ],
}
